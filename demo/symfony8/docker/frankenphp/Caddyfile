{
	skip_install_trust
}

# Worker mode (default): the app boots once and serves requests from memory, kernel kept alive and not reset between
# requests. The bundle keeps no request state in its services (docs/FRANKENPHP-WORKER-AUDIT.md).
:80 {
	root * /app/public
	encode zstd br gzip

	php_server {
		worker {
			file /app/public/index.php
			watch
		}
	}
}
