{
    "name": "nowo-tech/report-kit-demo-symfony8",
    "description": "Report Kit Bundle demo (Symfony 8, FrankenPHP worker mode, MySQL)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4,<8.6",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "nowo-tech/report-kit-bundle": "@dev",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^3.12",
        "twig/string-extra": "^3.12"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/console cache:clear --no-warmup"
        ],
        "post-update-cmd": [
            "@php bin/console cache:clear --no-warmup"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "/var/report-kit-bundle",
            "options": {
                "symlink": true
            }
        }
    ]
}
