{% extends 'base.html.twig' %}

{% block body %}
    <h1 class="h3 mb-3">Report Kit Bundle <span class="badge bg-secondary">S0 scaffold</span></h1>
    <p class="lead">Reports and scheduled exports for Symfony: report types with parameter schemas, PDF / XLSX / CSV / JSON renderers, server-side SVG charts, on-screen report pages and per-owner scheduled e-mail subscriptions.</p>
    <p>
        The package is built slice by slice from its design contract. S0 ships the bundle class and its strict
        configuration tree; the features arrive with the next slices (see <code>docs/ROADMAP.md</code>).
    </p>
    <table class="table table-sm bg-white" data-testid="demo-status">
        <tbody>
            <tr><th scope="row">Bundle</th><td><code>Nowo\ReportKitBundle\NowoReportKitBundle</code> registered, <code>nowo_report_kit.enabled</code> = <strong>{{ enabled ? 'true' : 'false' }}</strong></td></tr>
            <tr><th scope="row">API prefix parameter</th><td><code>%nowo_report_kit.api_prefix%</code> = <code>{{ api_prefix }}</code></td></tr>
            <tr><th scope="row">Table prefix</th><td><code>{{ table_prefix }}</code></td></tr>
            <tr><th scope="row">Database</th><td>{{ database is null ? 'not reachable' : 'MySQL ' ~ database }}</td></tr>
            <tr><th scope="row">FrankenPHP</th><td>{{ worker ? 'worker mode (kernel kept alive)' : 'classic mode' }}</td></tr>
        </tbody>
    </table>
{% endblock %}
