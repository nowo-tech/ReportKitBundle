<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nowo\ReportKitBundle\Domain\ReportRun (contract 221-C §5.1): idempotency and history of the scheduled runs. The unique
  key (subscription_id, slot_at) makes a Messenger retry or a double claim of one slot unable to send twice. Prefix and
  collation through Nowo\ReportKitBundle\Infrastructure\Doctrine\ReportKitMetadataListener.
-->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\ReportKitBundle\Domain\ReportRun" table="report_run" read-only="true">
        <indexes>
            <index name="idx_report_run_created" columns="created_at,id"/>
            <index name="idx_report_run_owner" columns="owner_type,owner_id"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_report_run_slot" columns="subscription_id,slot_at"/>
        </unique-constraints>

        <id name="id" type="string" column="id" length="36"/>

        <field name="subscriptionId" type="string" column="subscription_id" length="36"/>
        <field name="ownerType" type="string" column="owner_type" length="32"/>
        <field name="ownerId" type="string" column="owner_id" length="128"/>
        <field name="slotAt" type="datetime_immutable" column="slot_at"/>
        <field name="status" type="string" column="status" length="16"/>
        <field name="formats" type="json" column="formats"/>
        <field name="bytes" type="integer" column="bytes"/>
        <field name="durationMs" type="integer" column="duration_ms"/>
        <field name="errorCode" type="string" column="error_code" length="64" nullable="true"/>
        <field name="attempts" type="smallint" column="attempts"/>
        <field name="leaseAt" type="datetime_immutable" column="lease_at" nullable="true"/>
        <field name="leaseToken" type="string" column="lease_token" length="36" nullable="true"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
    </entity>
</doctrine-mapping>
